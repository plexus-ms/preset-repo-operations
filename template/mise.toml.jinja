# The tenant's operations repo (§ 3 PLX-Tenancy): the ops side, applied by
# playbook runs on its own occasions — it has no release cycle (§ 3 PLX-Delivery).
# One playbook per layer, each shipped in its plexus.* collection and mounted
# here (platform.yml{% if infrastructure %}, infrastructure.yml{% endif %}{% if ci_strategy != 'github' %}, ci.yml{% endif %}); third-party apps the tenant
# merely operates live under apps/<name>/ (§ 2 PLX-App).

# Verbs are asked as `mise :verb` at the repo root like in every tenant repo
# (§ 2 PLX-Repo); that form needs the root marker even without sub-projects.
monorepo_root = true
# mise no longer walks the tree for project configs; the root is the only one.
[monorepo]
config_roots = ["."]

[tools]
# node: the runtime of plx and plx-ci below and nothing else (the repo has no
# Node toolchain); pinned like every tool, since the tools' own pin says
# nothing about the runtime they run on, and bumped by the update bot.
node = "24"
hk = "latest" # Git hooks
uv = "latest" # required for ansible and copier
ansible = { version = "latest", uvx = true } # configuration management
copier = { version = "latest", uvx = true } # template management
# plx: the ops verbs the reusable workflows mount — deploy-targets, deploy
# (§ 6 PLX-Delivery). The initiative's own package, published from
# plexus-ms/primitives with provenance and bumped by the update bot; the
# trust-policy approval only waives npm's young-package heuristics.
# The pin is the train's to write, never the update bot's (§ 1 PLX-Updates).
"npm:@plexus-ms/cli" = { version = "0.115.0", allow_low_downloads = true }
{%- if ci_strategy == 'hybrid' or ci_registry == 'own' %}
# plx-ci: the daily housekeeping of the tenant's CI (§ 8 PLX-Delivery), the
# same package family at the same train number.
"npm:@plexus-ms/cli-ci" = { version = "0.115.0", allow_low_downloads = true }
{%- endif %}

[hooks]
# Wire up Git hooks
# On a CI runner whose mise installs only the tools a job names, hk is absent
# and the hook is not needed; it stays silent instead of failing.
postinstall = "if command -v hk >/dev/null; then hk install --mise; fi"


# Layer verbs — one playbook per layer, arguments passed through to
# ansible-playbook after `--`: `mise platform -- --tags apps --limit vm101`.

[tasks.platform]
depends = ["collections"]
description = "The platform layer on the app hosts (PLX-Platform): host baseline, deploy user, ingress, secrets, apps; --tags for a part"
run = './ansible-playbookw platform.yml'

{% if infrastructure -%}
[tasks.infrastructure]
depends = ["collections"]
description = "The infrastructure layer under the hosts (PLX-Infrastructure): hypervisor, guests, backup server, ingress VM; --tags for a part"
run = './ansible-playbookw infrastructure.yml'

{% endif -%}
{% if ci_strategy != 'github' -%}
[tasks.ci]
depends = ["collections"]
description = "The tenant's CI capacity (§ 8 PLX-Delivery): the runner host and its slots; --tags for a part"
run = './ansible-playbookw ci.yml'

{% endif -%}

# Contract verbs (§ 3 PLX-Repo) — every tenant repo answers them; the ones a
# operations repo has no use for exist and pass as documented no-ops.

[tasks.dev]
description = "No-op: an operations repo has no development environment to start"
run = 'echo "dev: nothing to start in an operations repo"'

[tasks.build]
description = "No-op: an operations repo produces no artifact; third-party apps pin published images"
run = 'echo "build: nothing to build in an operations repo"'

[tasks.check]
depends = ["collections"]
description = "Static checks: playbook syntax against the pinned collections"
run = [
    'ansible-playbook --syntax-check platform.yml',
{%- if infrastructure %}
    'ansible-playbook --syntax-check infrastructure.yml',
{%- endif %}
{%- if ci_strategy != 'github' %}
    'ansible-playbook --syntax-check ci.yml',
{%- endif %}
]

[tasks.test]
description = "No-op: an operations repo has no tests that gate a deploy"
run = 'echo "test: nothing to test in an operations repo"'

[tasks.verify]
description = "Perform all steps that verify code quality"
run = ['mise run check', 'mise run test']


# Propagation tasks

[tasks.sync]
description = "Update the project to the latest template version with Copier"
run = "copier update --trust"

# Internal / hidden tasks

[tasks.collections]
description = "Install the pinned plexus.* collections"
hide = true
run = 'ansible-galaxy collection install -r requirements.yml'
sources = ["requirements.yml"]
outputs = { auto = true }
