{% raw %}name: on_commit

# A push to `main`, the trunk that takes an operator's direct pushes (§ 2
# PLX-Delivery): `check`, which here is the whole contract verb, playbook
# syntax against the pinned collection. A change to nothing but Markdown
# starts nothing. Managed by copier: edit the preset
# (plexus-ms/preset-repo-operations), never this file.
#
# Where the jobs run is this repo's answer `ci_strategy` (§ 8 PLX-Delivery):
# {% endraw %}{{ ci_strategy }}{% raw %}. The repo variable CI_STRATEGY overrides it without a commit;
# `github` there is the way back to the forge's runners while a runner host
# is down.

on:
  push:
    branches: [main]
    paths-ignore: ['**/*.md']

permissions:
  contents: read

concurrency:
  group: on_commit-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    uses: plexus-ms/primitives/.github/workflows/_check.yml@0.113.0
    with:
      strategy: ${{ vars.CI_STRATEGY || '{% endraw %}{{ ci_strategy }}{% raw %}' }}
      size: small
      tasks: verify
{% endraw %}