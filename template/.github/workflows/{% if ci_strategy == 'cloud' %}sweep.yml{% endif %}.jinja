{% raw %}name: sweep

# Mounts the last teardown layer of the cloud CI strategy (§ 8 PLX-Delivery):
# once a day, and on demand, delete every CI instance on the tenant's cloud
# that is stopped or past its death deadline, drop the registry bucket of two
# months ago, and mail the alerts address when something was removed. The
# instances belong to the tenant, not to one app repo, which is why the sweep
# lives here. The logic is `plx-ci sweep` (@plexus-ms/cli-ci, pinned in
# mise.toml); the one secret is the CI vault's service account token,
# OP_SERVICE_ACCOUNT_TOKEN. Managed by copier: edit the preset
# (plexus-ms/preset-repo-platform), never this file.

on:
  schedule:
    - cron: '17 4 * * *'
  workflow_dispatch:
    inputs:
      dry_run:
        description: Only list what would be deleted
        type: boolean
        default: false

permissions:
  contents: read

jobs:
  sweep:
    uses: plexus-ms/primitives/.github/workflows/_sweep.yml@0.108.0
    with:
      runner: ${{ vars.CI_RUNNER || 'ubuntu-latest' }}
      dry-run: ${{ inputs.dry_run || false }}
      alerts-email: '{% endraw %}{{ alerts_email }}{% raw %}'
    secrets:
      op-service-account-token: ${{ secrets.OP_SERVICE_ACCOUNT_TOKEN }}
{% endraw %}
